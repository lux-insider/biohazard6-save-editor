// Aviso no rodapé, confirmação e "Sobre".
import { Tema } from "../tema.slint";
import { Ponte } from "../ponte.slint";
import { Botao, TextoJogo } from "basicos.slint";

export component Aviso inherits Rectangle {
    visible: Ponte.aviso-visivel;
    width: min(texto.preferred-width + 60px, 720px);
    height: texto.preferred-height + 22px;
    border-width: 1px;
    border-color: Ponte.aviso-tipo == 1 ? Tema.verde : (Ponte.aviso-tipo == 2 ? Tema.vermelho : Tema.borda);
    background: Ponte.aviso-tipo == 1 ? #0e2412f0 : (Ponte.aviso-tipo == 2 ? #2a0806f0 : #0b1020f0);
    drop-shadow-blur: 10px;
    drop-shadow-color: #00000060;
    texto := Text {
        x: 16px;
        width: parent.width - 48px;
        text: Ponte.aviso;
        color: Tema.texto;
        font-size: 14px;
        wrap: word-wrap;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - 26px;
        text: "✕";
        color: Tema.texto-2;
        vertical-alignment: center;
        TouchArea { mouse-cursor: pointer; clicked => { Ponte.fechar-aviso(); } }
    }
}

component Modal inherits Rectangle {
    background: #000000b0;
    TouchArea { }
    @children
}

export component Confirmacao inherits Modal {
    visible: Ponte.confirma-visivel;
    Rectangle {
        width: min(460px, root.width - 32px);
        height: corpo.preferred-height;
        background: Tema.painel;
        border-width: 1px;
        border-color: Tema.borda;
        corpo := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            TextoJogo { texto: Ponte.confirma-titulo; tamanho: 24px; }
            Text { text: Ponte.confirma-texto; wrap: word-wrap; color: Tema.texto-2; }
            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                Botao { texto: "VOLTAR"; clicado => { Ponte.confirma-resposta(false); } }
                Botao { texto: Ponte.confirma-sim; cheio: true; clicado => { Ponte.confirma-resposta(true); } }
            }
        }
    }
}

export component Sobre inherits Modal {
    visible: Ponte.sobre-visivel;
    Rectangle {
        width: min(540px, root.width - 32px);
        height: corpo.preferred-height;
        background: Tema.painel;
        border-width: 1px;
        border-color: Tema.borda;
        corpo := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            TextoJogo { texto: Ponte.titulo; tamanho: 24px; espaco: 1px; }
            Text { text: "Editor de save do Resident Evil 6 para Xbox 360."; wrap: word-wrap; color: Tema.texto-2; }
            Text { text: "Desenvolvido por lux-insider."; font-size: Tema.fonte-pequena; color: Tema.texto-2; }
            Text {
                text: "Resident Evil 6 / BIOHAZARD 6 © CAPCOM CO., LTD. As imagens e os textos do jogo pertencem à Capcom. Projeto de fã, gratuito e sem fins lucrativos, sem ligação com a Capcom ou a Microsoft.";
                wrap: word-wrap;
                font-size: Tema.fonte-pequena;
                color: Tema.texto-2;
            }
            HorizontalLayout {
                alignment: end;
                Botao { texto: "FECHAR"; clicado => { Ponte.sobre-visivel = false; } }
            }
        }
    }
}
