// Cores e medidas do editor, tiradas do HUD do BIOHAZARD 6: fundo azul
// quase preto, painéis translúcidos, texto branco e o azul da seleção.
export global Tema {
    out property <color> fundo: #04060c;
    out property <color> texto: #eef2f8;
    out property <color> texto-2: #9aa6b8;
    out property <color> desativado: #4f5869;
    out property <color> borda: #ffffff30;
    out property <color> linha: #ffffff17;
    out property <color> painel: #0a0f1ce0;
    out property <color> cartao: #0c1322c8;
    out property <color> campo: #00000080;
    out property <color> realce: #ffffff10;
    out property <color> azul: #1f6bff;
    out property <color> azul-claro: #5fa0ff;
    out property <color> azul-escuro: #0b2f7a;
    out property <color> vermelho: #d8342a;
    out property <color> verde: #6fcf6a;
    out property <color> laranja: #f0a040;
    out property <color> selecao: #1f6bff40;

    // A fonte de mensagens do próprio jogo (gerada da mes_font da ISO).
    out property <string> fonte-texto: "RE6 Mensagem";
    out property <string> fonte-titulo: "RE6 Mensagem";
    // Caminhos e códigos (IDs em hexadecimal) ficam numa fonte sem serifa.
    out property <string> fonte-dados: "Noto Sans";
    // Efeito dos títulos do jogo: sombra escura e um brilho azul fraco.
    out property <color> sombra: #000000d0;
    out property <color> brilho: #5fa0ff38;
    out property <length> fonte: 16px;
    out property <length> fonte-pequena: 14px;
}
